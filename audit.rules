-a always,exit -F arch=b64 -F path=/usr/bin/apt-get -F perm=x -k software_mgmt
-a always,exit -F arch=b64 -F path=/usr/bin/apt-key -F perm=x -k software_mgmt
-a always,exit -F arch=b64 -F path=/usr/bin/aptitude -F perm=x -k software_mgmt
-a always,exit -F arch=b64 -F path=/usr/bin/wajig -F perm=x -k software_mgmt
-a always,exit -F arch=b64 -F path=/usr/bin/snap -F perm=x -k software_mgmt

# PIP(3) (Python installs)
-a always,exit -F arch=b64 -F path=/usr/bin/pip -F perm=x -k T1072_third_party_software
-a always,exit -F arch=b64 -F path=/usr/local/bin/pip -F perm=x -k T1072_third_party_software
-a always,exit -F arch=b64 -F path=/usr/bin/pip3 -F perm=x -k T1072_third_party_software
-a always,exit -F arch=b64 -F path=/usr/local/bin/pip3 -F perm=x -k T1072_third_party_software
-a always,exit -F arch=b64 -F path=/usr/bin/pipx -F perm=x -k T1072_third_party_software
-a always,exit -F arch=b64 -F path=/usr/local/bin/pipx -F perm=x -k T1072_third_party_software

-a always,exit -F arch=b64 -F path=/usr/bin/python -F perm=x -k third_party_software_mgmt
-a always,exit -F arch=b64 -F path=/usr/bin/python2 -F perm=x -k third_party_software_mgmt
-a always,exit -F arch=b64 -F path=/usr/bin/python2.7 -F perm=x -k third_party_software_mgmt
-a always,exit -F arch=b64 -F path=/usr/bin/python3 -F perm=x -k third_party_software_mgmt

# LuaRocks (Lua installs)
