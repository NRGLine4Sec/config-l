# DPKG / APT-GET (Debian/Ubuntu)
-a always,exit -F arch=b64 -F path=/usr/bin/dpkg -F perm=x -k software_mgmt
-a always,exit -F arch=b64 -F path=/usr/bin/apt -F perm=x -k software_mgmt
-a always,exit -F arch=b64 -F path=/usr/bin/apt-add-repository -F perm=x -k software_mgmt
