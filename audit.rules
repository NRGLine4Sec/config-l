## Shell/profile configurations
-a always,exit -F arch=b64 -F dir=/etc/profile.d -F perm=wa -k shell_profiles
-a always,exit -F arch=b64 -F path=/etc/profile.d -F perm=wa -k shell_profiles
-a always,exit -F arch=b64 -F path=/etc/profile -F perm=wa -k shell_profiles
-a always,exit -F arch=b64 -F path=/etc/shells -F perm=wa -k shell_profiles
-a always,exit -F arch=b64 -F path=/etc/bashrc -F perm=wa -k shell_profiles
-a always,exit -F arch=b64 -F path=/etc/csh.cshrc -F perm=wa -k shell_profiles
-a always,exit -F arch=b64 -F path=/etc/csh.login -F perm=wa -k shell_profiles
-a always,exit -F arch=b64 -F dir=/etc/fish -F perm=wa -k shell_profiles
-a always,exit -F arch=b64 -F path=/etc/fish -F perm=wa -k shell_profiles
-a always,exit -F arch=b64 -F dir=/etc/zsh -F perm=wa -k shell_profiles
-a always,exit -F arch=b64 -F path=/etc/zsh -F perm=wa -k shell_profiles

## Injection
### These rules watch for code injection by the ptrace facility.
### This could indicate someone trying to do something bad or just debugging
-a always,exit -F arch=b64 -S ptrace -F a0=0x4 -k code_injection
-a always,exit -F arch=b64 -S ptrace -F a0=0x5 -k data_injection
-a always,exit -F arch=b64 -S ptrace -F a0=0x6 -k register_injection
-a always,exit -F arch=b64 -S ptrace -k tracing

## Anonymous File Creation
### These rules watch the use of memfd_create
### "memfd_create" creates anonymous file and returns a file descriptor to access it
### When combined with "fexecve" can be used to stealthily run binaries in memory without touching disk
-a always,exit -F arch=b64 -S memfd_create -F key=anon_file_create

## Privilege Abuse
### The purpose of this rule is to detect when an admin may be abusing power by looking in user's home dir.
-a always,exit -F arch=b64 -F dir=/home -F uid=0 -F auid>=1000 -F auid!=unset -C auid!=obj_uid -k power_abuse

# Socket Creations
# will catch both IPv4 and IPv6
-a always,exit -F arch=b64 -S socket -F a0=2 -k T1011_Exfiltration_Over_Other_Network_Medium
-a always,exit -F arch=b64 -S socket -F a0=10 -k T1011_Exfiltration_Over_Other_Network_Medium

# Namesapce usage
-a always,exit -F arch=b64 -S unshare -k susp_namespace_activity
# clone syscall with CLONE_NEWNS flag (0x00020000) is present in first argument "a0")
-a always,exit -F arch=b64 -S clone -F a0&0x00020000 -k susp_namespace_activity
-a always,exit -F arch=b64 -S setns -k susp_namespace_activity

