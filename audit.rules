# Linux Audit Daemon - Best Practice Configuration
# /etc/audit/audit.rules
#
# Compiled by Florian Roth
#
# Based on rules published here:
#  Gov.uk auditd rules
#  	https://github.com/gds-operations/puppet-auditd/pull/1
# 	CentOS 7 hardening
# 		https://highon.coffee/blog/security-harden-centos-7/#auditd---audit-daemon
# 	Linux audit repo
# 		https://github.com/linux-audit/audit-userspace/tree/master/rules
# 	Auditd high performance linux auditing
# 		https://linux-audit.com/tuning-auditd-high-performance-linux-auditing/
#
# Further rules
# 	For PCI DSS compliance see:
# 		https://github.com/linux-audit/audit-userspace/blob/master/rules/30-pci-dss-v31.rules
# 	For NISPOM compliance see:
# 		https://github.com/linux-audit/audit-userspace/blob/master/rules/30-nispom.rules

# Remove any existing rules
# important to add in ruleset, ref : [augenrules fails with “rule exists” when loading rules into auditd · Major Hayden](https://major.io/p/augenrules-fails-with-rule-exists-when-loading-rules-into-auditd/)
-D

# Buffer Size
## Feel free to increase this if the machine panic's
-b 8192

# Failure Mode
## Possible values: 0 (silent), 1 (printk, print a failure message), 2 (panic, halt the system)
-f 1

# Ignore errors
## e.g. caused by users or files not found in the local environment
-i

# Self Auditing ---------------------------------------------------------------

## Audit the audit logs
### Successful and unsuccessful attempts to read information from the audit records
-a always,exit -F arch=b64 -F dir=/var/log/audit -F perm=wra -k T1005_Data_From_Local_System_audit_log
-a always,exit -F arch=b64 -F path=/var/log/audit -F perm=wra -k T1005_Data_From_Local_System_audit_log
-a always,exit -F arch=b64 -F dir=/var/audit -F perm=wra -k T1005_Data_From_Local_System_audit_log
-a always,exit -F arch=b64 -F path=/var/audit -F perm=wra -k T1005_Data_From_Local_System_audit_log

## Auditd configuration
### Modifications to audit configuration that occur while the audit collection functions are operating
-a always,exit -F arch=b64 -F dir=/etc/audit -F perm=wa -k auditconfig
-a always,exit -F arch=b64 -F path=/etc/audit -F perm=wa -k auditconfig
-a always,exit -F arch=b64 -F path=/etc/libaudit.conf -F perm=wa -k auditconfig
-a always,exit -F arch=b64 -F dir=/etc/audisp -F perm=wa -k audispconfig
-a always,exit -F arch=b64 -F path=/etc/audisp -F perm=wa -k audispconfig

## Monitor for use of audit management tools
-a always,exit -F arch=b64 -F path=/sbin/auditctl -F perm=x -k audittools
-a always,exit -F arch=b64 -F path=/sbin/auditd -F perm=x -k audittools
-a always,exit -F arch=b64 -F path=/usr/sbin/auditd -F perm=x -k audittools
-a always,exit -F arch=b64 -F path=/usr/sbin/augenrules -F perm=x -k audittools

## Access to all audit trails
-a always,exit -F arch=b64 -F path=/usr/sbin/ausearch -F perm=x -k T1005_Data_From_Local_System_audit_log
-a always,exit -F arch=b64 -F path=/usr/sbin/aureport -F perm=x -k T1005_Data_From_Local_System_audit_log
-a always,exit -F arch=b64 -F path=/usr/sbin/aulast -F perm=x -k T1005_Data_From_Local_System_audit_log
-a always,exit -F arch=b64 -F path=/usr/sbin/aulastlogin -F perm=x -k T1005_Data_From_Local_System_audit_log
-a always,exit -F arch=b64 -F path=/usr/sbin/auvirt -F perm=x -k T1005_Data_From_Local_System_audit_log

# Filters ---------------------------------------------------------------------

### We put these early because audit is a first match wins system.

## Ignore SELinux AVC records
-a always,exclude -F msgtype=AVC

## Ignore current working directory records
-a always,exclude -F msgtype=CWD

## Ignore EOE records (End Of Event, not needed)
-a always,exclude -F msgtype=EOE

## This is not very interesting and wastes a lot of space if the server is public facing
-a always,exclude -F msgtype=CRYPTO_KEY_USER

### High Volume Event Filter (especially on Linux Workstations)
-a never,exit -F arch=b64 -F dir=/dev/shm -k sharedmemaccess
-a never,exit -F arch=b64 -F dir=/var/lock/lvm -k locklvm

## More information on how to filter events
### https://access.redhat.com/solutions/2482221

# Rules -----------------------------------------------------------------------

## Kernel parameters
-a always,exit -F arch=b64 -F path=/etc/sysctl.conf -F perm=wa -k sysctl
-a always,exit -F arch=b64 -F dir=/etc/sysctl.d -F perm=wa -k sysctl
-a always,exit -F arch=b64 -F path=/etc/sysctl.d -F perm=wa -k sysctl

## Kernel module loading and unloading
-a always,exit -F arch=b64 -F perm=x -F auid!=unset -F path=/sbin/insmod -k modules
-a always,exit -F arch=b64 -F perm=x -F auid!=unset -F path=/sbin/modprobe -k modules
-a always,exit -F arch=b64 -F perm=x -F auid!=unset -F path=/sbin/rmmod -k modules
-a always,exit -F arch=b64 -S finit_module -S init_module -S delete_module -F auid!=unset -k modules

## Modprobe configuration
-a always,exit -F arch=b64 -F path=/etc/modprobe.conf -F perm=wa -k modprobe
-a always,exit -F arch=b64 -F dir=/etc/modprobe.d -F perm=wa -k modprobe
-a always,exit -F arch=b64 -F path=/etc/modprobe.d -F perm=wa -k modprobe

## KExec usage (all actions)
-a always,exit -F arch=b64 -S kexec_load -k KEXEC

## Special files
-a always,exit -F arch=b64 -S mknod -S mknodat -k specialfiles

## Mount operations (only attributable)
-a always,exit -F arch=b64 -S mount -S umount2 -F auid!=unset -k mount

### NFS mount
-a always,exit -F arch=b64 -F path=/sbin/mount.nfs -F perm=x -F auid>=500 -F auid!=unset -k T1078_Valid_Accounts
-a always,exit -F arch=b64 -F path=/usr/sbin/mount.nfs -F perm=x -F auid>=500 -F auid!=unset -k T1078_Valid_Accounts

## Change swap (only attributable)
-a always,exit -F arch=b64 -S swapon -S swapoff -F auid!=unset -k swap

## Time
# -a always,exit -F arch=b64 -F uid!=ntp -S adjtimex -S settimeofday -S clock_settime -k time
### Local time zone
-a always,exit -F arch=b64 -F path=/etc/localtime -F perm=wa -k localtime

## Stunnel
-a always,exit -F arch=b64 -F path=/usr/sbin/stunnel -F perm=x -k stunnel
-a always,exit -F arch=b64 -F path=/usr/bin/stunnel -F perm=x -k stunnel

## Cron configuration & scheduled jobs
-a always,exit -F arch=b64 -F path=/etc/cron.allow -F perm=wa -k cron
-a always,exit -F arch=b64 -F path=/etc/cron.deny -F perm=wa -k cron
-a always,exit -F arch=b64 -F dir=/etc/cron.d -F perm=wa -k cron
-a always,exit -F arch=b64 -F path=/etc/cron.d -F perm=wa -k cron
-a always,exit -F arch=b64 -F dir=/etc/cron.daily -F perm=wa -k cron
-a always,exit -F arch=b64 -F path=/etc/cron.daily -F perm=wa -k cron
-a always,exit -F arch=b64 -F dir=/etc/cron.hourly -F perm=wa -k cron
-a always,exit -F arch=b64 -F path=/etc/cron.hourly -F perm=wa -k cron
-a always,exit -F arch=b64 -F dir=/etc/cron.monthly -F perm=wa -k cron
-a always,exit -F arch=b64 -F path=/etc/cron.monthly -F perm=wa -k cron
-a always,exit -F arch=b64 -F dir=/etc/cron.weekly -F perm=wa -k cron
-a always,exit -F arch=b64 -F path=/etc/cron.weekly -F perm=wa -k cron
-a always,exit -F arch=b64 -F path=/etc/crontab -F perm=wa -k cron
-a always,exit -F arch=b64 -F dir=/var/spool/cron -F perm=wa -k cron
-a always,exit -F arch=b64 -F path=/var/spool/cron -F perm=wa -k cron

## User, group, password databases
-a always,exit -F arch=b64 -F path=/etc/group -F perm=wa -k etcgroup
-a always,exit -F arch=b64 -F path=/etc/passwd -F perm=wa -k etcpasswd
-a always,exit -F arch=b64 -F path=/etc/gshadow -F perm=rwxa -k etcgroup
-a always,exit -F arch=b64 -F path=/etc/shadow -F perm=rwxa -k etcpasswd
-a always,exit -F arch=b64 -F path=/etc/security/opasswd -F perm=rwxa -k opasswd

## Sudoers file changes
-a always,exit -F arch=b64 -F path=/etc/sudoers -F perm=wa -k actions
-a always,exit -F arch=b64 -F dir=/etc/sudoers.d -F perm=wa -k actions
-a always,exit -F arch=b64 -F path=/etc/sudoers.d -F perm=wa -k actions

## Passwd
-a always,exit -F arch=b64 -F path=/usr/bin/passwd -F perm=x -k passwd_modification

## Tools to change group identifiers
-a always,exit -F arch=b64 -F path=/usr/sbin/groupadd -F perm=x -k group_modification
-a always,exit -F arch=b64 -F path=/usr/sbin/groupmod -F perm=x -k group_modification
-a always,exit -F arch=b64 -F path=/usr/sbin/addgroup -F perm=x -k group_modification
-a always,exit -F arch=b64 -F path=/usr/sbin/useradd -F perm=x -k user_modification
-a always,exit -F arch=b64 -F path=/usr/sbin/userdel -F perm=x -k user_modification
-a always,exit -F arch=b64 -F path=/usr/sbin/usermod -F perm=x -k user_modification
-a always,exit -F arch=b64 -F path=/usr/sbin/adduser -F perm=x -k user_modification

## Login configuration and information
-a always,exit -F arch=b64 -F path=/etc/login.defs -F perm=wa -k login
-a always,exit -F arch=b64 -F path=/etc/securetty -F perm=wa -k login
-a always,exit -F arch=b64 -F path=/var/log/faillog -F perm=wa -k login
-a always,exit -F arch=b64 -F path=/var/log/lastlog -F perm=wa -k login
-a always,exit -F arch=b64 -F path=/var/log/tallylog -F perm=wa -k login

## Network Environment
### Changes to hostname
-a always,exit -F arch=b64 -S sethostname -S setdomainname -k network_modifications

### Detect Remote Shell Use
-a always,exit -F arch=b64 -F exe=/bin/bash -F success=1 -S connect -k remote_shell
-a always,exit -F arch=b64 -F exe=/usr/bin/bash -F success=1 -S connect -k remote_shell

### Successful IPv4 Connections
-a always,exit -F arch=b64 -S connect -F a2=16 -F success=1 -F key=network_connect_4

### Successful IPv6 Connections
-a always,exit -F arch=b64 -S connect -F a2=28 -F success=1 -F key=network_connect_6

### Changes to other files
-a always,exit -F arch=b64 -F path=/etc/hosts -F perm=wa -k network_modifications
-a always,exit -F arch=b64 -F dir=/etc/network -F perm=wa -k network
-a always,exit -F arch=b64 -F path=/etc/network -F perm=wa -k network
-a always,exit -F arch=b64 -F dir=/etc/NetworkManager/ -F perm=wa -k network_modifications

### Changes to issue
-a always,exit -F arch=b64 -F path=/etc/issue -F perm=wa -k etcissue
-a always,exit -F arch=b64 -F path=/etc/issue.net -F perm=wa -k etcissue

## System startup scripts
-a always,exit -F arch=b64 -F dir=/etc/init.d -F perm=wa -k init
-a always,exit -F arch=b64 -F path=/etc/init.d -F perm=wa -k init
-a always,exit -F arch=b64 -F dir=/etc/init -F perm=wa -k init
-a always,exit -F arch=b64 -F path=/etc/init -F perm=wa -k init

## Library search paths
-a always,exit -F arch=b64 -F path=/etc/ld.so.conf -F perm=wa -k libpath
-a always,exit -F arch=b64 -F dir=/etc/ld.so.conf.d -F perm=wa -k libpath
-a always,exit -F arch=b64 -F path=/etc/ld.so.conf.d -F perm=wa -k libpath

## Systemwide library preloads (LD_PRELOAD)
-a always,exit -F arch=b64 -F path=/etc/ld.so.preload -F perm=wa -k systemwide_preloads

## Pam configuration
-a always,exit -F arch=b64 -F dir=/etc/pam.d -F perm=wa -k pam
-a always,exit -F arch=b64 -F path=/etc/pam.d -F perm=wa -k pam
-a always,exit -F arch=b64 -F path=/etc/security/limits.conf -F perm=wa -k pam
-a always,exit -F arch=b64 -F dir=/etc/security/limits.d -F perm=wa -k pam
-a always,exit -F arch=b64 -F path=/etc/security/limits.d -F perm=wa -k pam
-a always,exit -F arch=b64 -F path=/etc/security/pam_env.conf -F perm=wa -k pam
-a always,exit -F arch=b64 -F path=/etc/security/namespace.conf -F perm=wa -k pam
-a always,exit -F arch=b64 -F dir=/etc/security/namespace.d -F perm=wa -k pam
-a always,exit -F arch=b64 -F path=/etc/security/namespace.d -F perm=wa -k pam
-a always,exit -F arch=b64 -F path=/etc/security/namespace.init -F perm=wa -k pam

## Mail configuration
-a always,exit -F arch=b64 -F path=/etc/aliases -F perm=wa -k mail
-a always,exit -F arch=b64 -F dir=/etc/postfix -F perm=wa -k mail
-a always,exit -F arch=b64 -F path=/etc/postfix -F perm=wa -k mail
-a always,exit -F arch=b64 -F dir=/etc/exim4 -F perm=wa -k mail
-a always,exit -F arch=b64 -F path=/etc/exim4 -F perm=wa -k mail

## SSH configuration
-a always,exit -F arch=b64 -F path=/etc/ssh/sshd_config -F perm=rwxa -k sshd
-a always,exit -F arch=b64 -F dir=/etc/ssh/sshd_config.d -F perm=rwxa -k sshd
-a always,exit -F arch=b64 -F path=/etc/ssh/sshd_config.d -F perm=rwxa -k sshd

## root ssh key tampering
-a always,exit -F arch=b64 -F dir=/root/.ssh -F perm=wa -k rootkey
-a always,exit -F arch=b64 -F path=/root/.ssh -F perm=wa -k rootkey

# Systemd
-a always,exit -F arch=b64 -F path=/bin/systemctl -F perm=x -k systemd
-a always,exit -F arch=b64 -F dir=/etc/systemd -F perm=wa -k systemd
-a always,exit -F arch=b64 -F path=/etc/systemd -F perm=wa -k systemd
-a always,exit -F arch=b64 -F dir=/usr/lib/systemd -F perm=wa -k systemd
-a always,exit -F arch=b64 -F path=/usr/lib/systemd -F perm=wa -k systemd

## https://systemd.network/systemd.generator.html
-a always,exit -F arch=b64 -F dir=/etc/systemd/system-generators -F perm=wa -k T1543_Create_or_Modify_System_Process_systemd_generator
-a always,exit -F arch=b64 -F path=/etc/systemd/system-generators -F perm=wa -k T1543_Create_or_Modify_System_Process_systemd_generator
-a always,exit -F arch=b64 -F dir=/usr/local/lib/systemd/system-generators -F perm=wa -k T1543_Create_or_Modify_System_Process_systemd_generator
-a always,exit -F arch=b64 -F path=/usr/local/lib/systemd/system-generators -F perm=wa -k T1543_Create_or_Modify_System_Process_systemd_generator
-a always,exit -F arch=b64 -F dir=/usr/lib/systemd/system-generators -F perm=wa -k T1543_Create_or_Modify_System_Process_systemd_generator
-a always,exit -F arch=b64 -F path=/usr/lib/systemd/system-generators -F perm=wa -k T1543_Create_or_Modify_System_Process_systemd_generator

-a always,exit -F arch=b64 -F dir=/etc/systemd/user-generators -F perm=wa -k T1543_Create_or_Modify_System_Process_systemd_generator
-a always,exit -F arch=b64 -F path=/etc/systemd/user-generators -F perm=wa -k T1543_Create_or_Modify_System_Process_systemd_generator
-a always,exit -F arch=b64 -F dir=/usr/local/lib/systemd/user-generators -F perm=wa -k T1543_Create_or_Modify_System_Process_systemd_generator
-a always,exit -F arch=b64 -F path=/usr/local/lib/systemd/user-generators -F perm=wa -k T1543_Create_or_Modify_System_Process_systemd_generator
-a always,exit -F arch=b64 -F dir=/lib/systemd/system-generators -F perm=wa -k T1543_Create_or_Modify_System_Process_systemd_generator
-a always,exit -F arch=b64 -F path=/lib/systemd/system-generators -F perm=wa -k T1543_Create_or_Modify_System_Process_systemd_generator

## SELinux events that modify the system's Mandatory Access Controls (MAC)
-a always,exit -F arch=b64 -F dir=/etc/selinux -F perm=wa -k mac_policy
-a always,exit -F arch=b64 -F path=/etc/selinux -F perm=wa -k mac_policy
### setfiles
### https://www.stigviewer.com/stig/red_hat_enterprise_linux_8/2021-12-03/finding/V-230430
-a always,exit -F arch=b64 -F path=/usr/bin/setfiles -F perm=x -F auid>=500 -F auid!=unset -k mac_policy
-a always,exit -F arch=b64 -F path=/usr/sbin/setfiles -F perm=x -F auid>=500 -F auid!=unset -k mac_policy

## Critical elements access failures
-a always,exit -F arch=b64 -S open,openat -F dir=/etc -F exit=-EACCES -k unauthedfileaccess
-a always,exit -F arch=b64 -S open,openat -F dir=/etc -F exit=-EPERM -k unauthedfileaccess
-a always,exit -F arch=b64 -S open,openat -F dir=/bin -F exit=-EACCES -k unauthedfileaccess
-a always,exit -F arch=b64 -S open,openat -F dir=/bin -F exit=-EPERM -k unauthedfileaccess
-a always,exit -F arch=b64 -S open,openat -F dir=/sbin -F exit=-EACCES -k unauthedfileaccess
-a always,exit -F arch=b64 -S open,openat -F dir=/sbin -F exit=-EPERM -k unauthedfileaccess
-a always,exit -F arch=b64 -S open,openat -F dir=/usr/bin -F exit=-EACCES -k unauthedfileaccess
-a always,exit -F arch=b64 -S open,openat -F dir=/usr/bin -F exit=-EPERM -k unauthedfileaccess
-a always,exit -F arch=b64 -S open,openat -F dir=/usr/sbin -F exit=-EACCES -k unauthedfileaccess
-a always,exit -F arch=b64 -S open,openat -F dir=/usr/sbin -F exit=-EPERM -k unauthedfileaccess
-a always,exit -F arch=b64 -S open,openat -F dir=/var -F exit=-EACCES -k unauthedfileaccess
-a always,exit -F arch=b64 -S open,openat -F dir=/var -F exit=-EPERM -k unauthedfileaccess
-a always,exit -F arch=b64 -S open,openat -F dir=/home -F exit=-EACCES -k unauthedfileaccess
-a always,exit -F arch=b64 -S open,openat -F dir=/home -F exit=-EPERM -k unauthedfileaccess
-a always,exit -F arch=b64 -S open,openat -F dir=/srv -F exit=-EACCES -k unauthedfileaccess
-a always,exit -F arch=b64 -S open,openat -F dir=/srv -F exit=-EPERM -k unauthedfileaccess

## Process ID change (switching accounts) applications
-a always,exit -F arch=b64 -F path=/bin/su -F perm=x -k priv_esc
-a always,exit -F arch=b64 -F path=/usr/bin/sudo -F perm=x -k priv_esc
-a always,exit -F arch=b64 -F path=/etc/sudoers -F perm=rw -k priv_esc
-a always,exit -F arch=b64 -F dir=/etc/sudoers.d -F perm=rw -k priv_esc
-a always,exit -F arch=b64 -F path=/etc/sudoers.d -F perm=rw -k priv_esc

## Power state
-a always,exit -F arch=b64 -F path=/sbin/shutdown -F perm=x -k power
-a always,exit -F arch=b64 -F path=/sbin/poweroff -F perm=x -k power
-a always,exit -F arch=b64 -F path=/sbin/reboot -F perm=x -k power
-a always,exit -F arch=b64 -F path=/sbin/halt -F perm=x -k power

## Session initiation information
-a always,exit -F arch=b64 -F path=/var/run/utmp -F perm=wa -k session
-a always,exit -F arch=b64 -F path=/var/log/btmp -F perm=wa -k session
-a always,exit -F arch=b64 -F path=/var/log/wtmp -F perm=wa -k session

## Discretionary Access Control (DAC) modifications
-a always,exit -F arch=b64 -S chmod -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b64 -S chown -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b64 -S fchmod -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b64 -S fchmodat -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b64 -S fchown -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b64 -S fchownat -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b64 -S fremovexattr -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b64 -S fsetxattr -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b64 -S lchown -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b64 -S lremovexattr -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b64 -S lsetxattr -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b64 -S removexattr -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b64 -S setxattr -F auid>=1000 -F auid!=unset -k perm_mod

# Special Rules ---------------------------------------------------------------

## Reconnaissance
-a always,exit -F arch=b64 -F path=/usr/bin/whoami -F perm=x -k recon
-a always,exit -F arch=b64 -F path=/usr/bin/id -F perm=x -k recon
-a always,exit -F arch=b64 -F path=/bin/hostname -F perm=x -k recon
-a always,exit -F arch=b64 -F path=/bin/uname -F perm=x -k recon
-a always,exit -F arch=b64 -F path=/etc/issue -F perm=r -k recon
-a always,exit -F arch=b64 -F path=/etc/hostname -F perm=r -k recon
-a always,exit -F arch=b64 -F path=/usr/bin/hostnamectl -F perm=x -k recon
-a always,exit -F arch=b64 -F path=/usr/bin/loginctl -F perm=x -k recon

## Suspicious activity
-a always,exit -F arch=b64 -F path=/usr/bin/wget -F perm=x -k susp_activity
-a always,exit -F arch=b64 -F path=/usr/bin/curl -F perm=x -k susp_activity
-a always,exit -F arch=b64 -F path=/usr/bin/lwp-request -F perm=x -k susp_activity
-a always,exit -F arch=b64 -F path=/usr/bin/base64 -F perm=x -k susp_activity
-a always,exit -F arch=b64 -F path=/usr/bin/base32 -F perm=x -k susp_activity
-a always,exit -F arch=b64 -F path=/bin/nc -F perm=x -k susp_activity

-a always,exit -F arch=b64 -F path=/bin/netcat -F perm=x -k susp_activity
-a always,exit -F arch=b64 -F path=/usr/bin/ncat -F perm=x -k susp_activity
-a always,exit -F arch=b64 -F path=/usr/bin/ss -F perm=x -k susp_activity
-a always,exit -F arch=b64 -F path=/usr/bin/netstat -F perm=x -k susp_activity
-a always,exit -F arch=b64 -F path=/usr/bin/ssh -F perm=x -k susp_activity
-a always,exit -F arch=b64 -F path=/usr/bin/scp -F perm=x -k susp_activity
-a always,exit -F arch=b64 -F path=/usr/bin/sftp -F perm=x -k susp_activity
-a always,exit -F arch=b64 -F path=/usr/bin/ftp -F perm=x -k susp_activity
-a always,exit -F arch=b64 -F path=/usr/bin/socat -F perm=x -k susp_activity
-a always,exit -F arch=b64 -F path=/usr/bin/wireshark -F perm=x -k susp_activity
-a always,exit -F arch=b64 -F path=/usr/bin/tshark -F perm=x -k susp_activity
-a always,exit -F arch=b64 -F path=/usr/bin/rawshark -F perm=x -k susp_activity
