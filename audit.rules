### may indicate privilege escalation CVE-2021-3560
-a always,exit -F arch=b64 -F path=/usr/bin/dbus-send -F perm=x -k dbus_send
-a always,exit -F arch=b64 -F path=/usr/bin/gdbus -F perm=x -k gdbus_call
-a always,exit -F arch=b64 -F path=/usr/bin/busctl -F perm=x -k busctl_call

### dbus
-a always,exit -F arch=b64 -F path=/lib64/dbus-1/dbus-daemon-launch-helper -F perm=x -F auid>=500 -F auid!=unset -k T1078_Valid_Accounts
-a always,exit -F arch=b64 -F path=/usr/lib64/dbus-1/dbus-daemon-launch-helper -F perm=x -F auid>=500 -F auid!=unset -k T1078_Valid_Accounts
-a always,exit -F arch=b64 -F path=/usr/lib/dbus-1.0/dbus-daemon-launch-helper -F perm=x -F auid>=500 -F auid!=unset -k T1078_Valid_Accounts

